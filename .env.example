# Scegli UNA chiave (o più) — ORBIT sceglie il provider in automatico
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Opzionali
# ORBIT_PROVIDER=anthropic        # anthropic | deepseek | openai | openrouter | ollama
# ORBIT_MODEL=claude-sonnet-5
# ORBIT_MODE=ask                  # ask | auto | readonly
# ORBIT_WORKSPACE=C:\Users\te\progetti
# ORBIT_PORT=7777
# ORBIT_THINKING=0                # budget token di ragionamento (solo Anthropic)
# BRAVE_API_KEY=                  # ricerca web migliore (altrimenti DuckDuckGo)
